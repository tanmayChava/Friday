# ==============================================================================
# FRIDAY AI Assistant — Environment Variables
# Copy this file to .env and fill in the values before starting.
# ==============================================================================

# Telegram Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Your personal numeric Telegram User ID (get it from @userinfobot on Telegram)
# ONLY this user will be permitted to chat with FRIDAY.
TELEGRAM_ALLOWED_USER_ID="123456789"

# AI Model Configuration
# gemini (recommended), groq, or openai
DEFAULT_LLM_PROVIDER="gemini"
# Gemini model name (default: gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy..."

# Groq API Key (High-speed fallback or primary; get from https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI API Key (Optional fallback or primary)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Embedding Model (Google Gemini API; default: gemini-embedding-2, 768 dimensions)
EMBEDDING_MODEL="gemini-embedding-2"

# Tavily AI Search API Key (Get from https://tavily.com)
TAVILY_API_KEY="tvly-..."

# Supabase Configuration (Get from Supabase Dashboard -> Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Personalization Settings
USER_TIMEZONE="Asia/Kolkata"
USER_NAME="Boss"
BRIEFING_TIME="07:00"
BRIEFING_MISSED_GRACE_PERIOD_MINUTES="120"

# Daily Usage Caps (Cost Protection)
DAILY_LLM_CALL_CAP="100"
DAILY_TAVILY_CALL_CAP="50"

# Deployment Configuration (Optional)
# Leave empty for Long Polling mode (recommended for local dev and Railway workers)
# Provide your Railway public URL if using Webhook mode (e.g., https://your-app.up.railway.app)
WEBHOOK_URL=""
# Required when WEBHOOK_URL is set; use a random value of at least 16 characters.
TELEGRAM_WEBHOOK_SECRET=""
# Port for health server. Cloud providers like Railway dynamically inject PORT, which automatically overrides this.
HEALTH_PORT="8080"

# Node Environment
NODE_ENV="development"
