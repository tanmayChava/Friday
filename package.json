{
  "name": "friday-ai-assistant",
  "version": "1.0.0",
  "description": "FRIDAY - Personalized Telegram AI Assistant powered by Gemini 3.5 Flash Lite, Supabase, and Tavily Search",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-ai-sdk.cjs"
  },
  "keywords": [
    "ai",
    "assistant",
    "telegram-bot",
    "gemini",
    "supabase",
    "tavily",
    "friday"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "ai": "^4.3.0",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^1.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
